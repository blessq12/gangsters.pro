APP_NAME="Gangster's Sushi"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# Базовый URL SPA (canonical, OG, ссылки сброса пароля). По умолчанию — APP_URL.
# CLIENT_FRONTEND_URL=https://example.com
# SITE_NAME="Gangster's Sushi"
# Имя на иконке Home Screen / PWA (manifest short_name, iOS title)
# SITE_PWA_DISPLAY_NAME="Гангстерс Суши"
# SITE_SHORT_NAME="Гангстерс Суши"
# SITE_DEFAULT_TITLE="Доставка суши и роллов в Томске | Gangster's Sushi"
# SITE_DEFAULT_DESCRIPTION="Закажи суши, роллы и горячие блюда с доставкой по Томску."

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_APP_NAME="${APP_NAME}"
VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_PARSE_MODE=HTML
TELEGRAM_TOPIC_ANALYTICS=3
TELEGRAM_TOPIC_ERROR=2
TELEGRAM_TOPIC_EVENT=58

CLIENT_PASSWORD_RESET_TOKEN_TTL_MINUTES=30

# Яндекс.Карты JS API 2.1 (редактор зоны доставки в Filament /admin). Ограничьте ключ по HTTP Referrer.
# YANDEX_MAPS_API_KEY=
# YANDEX_GEOCODER_API_KEY=

# Маркетинг / Filament: лимит одного файла (КБ). 0 = только PHP (рекомендуется). См. docs/admin-media-upload-limits.md
# MARKETING_BANNER_MAX_UPLOAD_KB=0
# MARKETING_PROMOTION_MAX_UPLOAD_KB=0

# Правила корзины (фолбэк; детали — в админке «Магазин → Правила корзины», флаги на товаре — в карточке товара)
# SHOPPING_RULE_COMPLEMENT_ENABLED=true
# SHOPPING_RULE_ROLLS_PER_COMPLEMENT=2
# SHOPPING_RULE_GIFT_ENABLED=true
# SHOPPING_RULE_GIFT_THRESHOLD_KOPECKS=180000
