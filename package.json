{
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "npm run dev:public",
        "dev:public": "vite --config apps/public/vite.config.js",
        "dev:backoffice": "vite --config apps/backoffice/vite.config.js",
        "build:public": "vite build --config apps/public/vite.config.js && npm run sync:pwa:public",
        "build:backoffice": "vite build --config apps/backoffice/vite.config.js && npm run sync:pwa:backoffice",
        "build": "npm run build:public && npm run build:backoffice",
        "sync:pwa:public": "mkdir -p public/pwa/public && cp apps/public/pwa/manifest.webmanifest apps/public/pwa/sw.js public/pwa/public/",
        "sync:pwa:backoffice": "mkdir -p public/pwa/backoffice && cp apps/backoffice/pwa/manifest.webmanifest apps/backoffice/pwa/sw.js public/pwa/backoffice/",
        "test:backoffice-guard": "node --test apps/backoffice/shell/guard/resolveGuardTarget.test.js",
        "test:public-formation": "node --test apps/public/modules/checkout/domain/formation/formCheckout.test.js",
        "lint": "eslint apps/public apps/backoffice",
        "lint:backoffice-roles": "eslint \"apps/backoffice/roles/**/*.js\" \"apps/backoffice/shell/**/*.js\" \"apps/backoffice/router/**/*.js\" apps/backoffice/app.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "knip": "knip",
        "depcheck": "depcheck",
        "check": "bash scripts/check.sh",
        "check:fix": "bash scripts/check.sh --fix"
    },
    "devDependencies": {
        "@eslint/js": "^9.39.5",
        "@vitejs/plugin-vue": "^4.0.0",
        "axios": "^1.6.1",
        "depcheck": "^1.4.7",
        "eslint": "^9.11.1",
        "eslint-plugin-unused-imports": "^4.4.1",
        "eslint-plugin-vue": "^10.12.1",
        "knip": "^6.48.0",
        "laravel-vite-plugin": "^1.0.0",
        "prettier": "^3.10.1",
        "sass": "^1.56.1",
        "vite": "^5.2.0",
        "vue": "^3.2.37"
    },
    "dependencies": {
        "@mdi/font": "^7.4.47",
        "@tailwindcss/vite": "^4.1.5",
        "@tiptap/extension-color": "^2.27.2",
        "@tiptap/extension-image": "^2.27.2",
        "@tiptap/extension-link": "^2.27.2",
        "@tiptap/extension-placeholder": "^2.27.2",
        "@tiptap/extension-table": "^2.27.2",
        "@tiptap/extension-table-cell": "^2.27.2",
        "@tiptap/extension-table-header": "^2.27.2",
        "@tiptap/extension-table-row": "^2.27.2",
        "@tiptap/extension-text-align": "^2.27.2",
        "@tiptap/extension-text-style": "^2.27.2",
        "@tiptap/extension-underline": "^2.27.2",
        "@tiptap/pm": "^2.27.2",
        "@tiptap/starter-kit": "^2.27.2",
        "@tiptap/vue-3": "^2.27.2",
        "@vuepic/vue-datepicker": "^14.1.0",
        "gsap": "^3.13.0",
        "maska": "^2.1.10",
        "pinia": "^2.1.7",
        "sortablejs": "^1.15.7",
        "swiper": "^11.1.4",
        "tailwindcss": "^4.1.5",
        "vue-lazyload": "^3.0.0",
        "vue-router": "^4.6.4",
        "vue-toastification": "^2.0.0-rc.5",
        "vuedraggable": "^4.1.0"
    }
}
